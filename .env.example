# ============================================================================
# Variables d'environnement ATS Valrose
# ============================================================================
# En local : copier ce fichier en .env.local et remplir les valeurs.
# En prod : ajouter ces variables dans Vercel → Settings → Environment Variables.
# Doc complète de restauration : voir RESTAURATION.md
# ============================================================================

# --- Supabase (indispensable) ---
# Supabase → Project Settings → API
SUPABASE_URL=
# Clé secrète serveur (service_role / secret key). SECRET, jamais côté navigateur.
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin (indispensable) ---
# Mot de passe d'accès à /admin (choisir un mot de passe fort)
ADMIN_PASSWORD=

# --- Email : envoi via SMTP (indispensable pour les emails de confirmation) ---
# Réglages de la boîte email (ex. Hostinger). Si SMTP_PASS est absent, les
# emails sont seulement loggés, pas envoyés.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=contact@ats-valrose.fr
SMTP_PASS=
EMAIL_FROM="ATS Valrose <contact@ats-valrose.fr>"
EMAIL_TO_NOTIFICATIONS=contact@ats-valrose.fr
# Prof prévenu des inscriptions Pickleball (défaut Bo.dollet@orange.fr)
EMAIL_COACH_PICKLEBALL=
# Copie des emails envoyés dans le dossier « Envoyés » (optionnel)
IMAP_HOST=
IMAP_PORT=993

# --- Page planning coachs (optionnel) ---
# Jeton secret du lien /planning-stages/<jeton>. Un défaut existe dans le code ;
# définir cette variable permet de changer/révoquer le lien.
PLANNING_PUBLIC_TOKEN=

# --- Suivi des erreurs Sentry (optionnel) ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# ============================================================================
# Variables utilisées UNIQUEMENT par les scripts locaux (pas sur Vercel)
# ============================================================================
# Connexion Postgres directe (sauvegardes, migrations, imports).
# Supabase → Project Settings → Database → Connection string (URI).
SUPABASE_DB_URL=
# Dossier de destination des sauvegardes (défaut ./backups)
# BACKUP_DIR=C:\Users\...\OneDrive\ATS-Valrose-Sauvegardes
# Clé de l'outil local de génération d'images (facultatif)
# ZAI_API_KEY=
