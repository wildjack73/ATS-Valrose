# ============================================================================
# Variables d'environnement ATS Valrose
# ============================================================================
# En local : copier ce fichier en .env.local et remplir les valeurs.
# En prod sur Hostinger : ajouter ces variables dans le panneau de l'app Node.js.

# --- Supabase ---
# Récupérer ces 3 valeurs sur https://supabase.com → ton projet → Project Settings → API
SUPABASE_URL=
# "Publishable key" (anciennement "anon public") — peut commencer par sb_publishable_ ou eyJ...
SUPABASE_ANON_KEY=
# "Secret key" (anciennement "service_role") — peut commencer par sb_secret_ ou eyJ...
# SECRET, à ne jamais exposer côté navigateur
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin ---
# Mot de passe d'accès à /admin (choisir un mot de passe fort)
ADMIN_PASSWORD=

# --- Email (optionnel) ---
# Si vide, les emails de confirmation seront simplement loggés sans être envoyés
RESEND_API_KEY=
EMAIL_FROM="ATS Valrose <contact@ats-valrose.fr>"
EMAIL_TO_NOTIFICATIONS=contact@ats-valrose.fr
